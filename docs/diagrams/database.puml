@startuml
title Cinema Booking - Mo hinh du lieu hien tai
hide circle
skinparam backgroundColor #FAFBFD
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam entity {
  BackgroundColor #F2F4F7
  BorderColor #39739D
  HeaderBackgroundColor #326B93
  HeaderFontColor white
}

entity "users" as users {
  * user_id : INTEGER <<PK>>
  --
  email : VARCHAR <<UNIQUE>>
  username : VARCHAR
  password_hash : VARCHAR
  role : VARCHAR
}

entity "movies" as movies {
  * id : INTEGER <<PK>>
  --
  title : VARCHAR(255) <<INDEX>>
  description : TEXT <<NULL>>
  duration_minutes : INTEGER
}

entity "showtimes" as showtimes {
  * id : INTEGER <<PK>>
  --
  movie_id : INTEGER <<FK, INDEX>>
  start_time : DATETIME <<INDEX, naive UTC>>
  total_seats : INTEGER
}

entity "bookings" as bookings {
  * id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK>>
  showtime_id : INTEGER <<FK>>
  seat_number : VARCHAR
  status : VARCHAR
  created_at : DATETIME WITH TIME ZONE
}

entity "seat_holds" as seat_holds {
  * id : INTEGER <<PK>>
  --
  user_id : INTEGER <<FK, INDEX>>
  showtime_id : INTEGER <<FK, INDEX>>
  status : VARCHAR(20)
  created_at : DATETIME WITH TIME ZONE
  expires_at : DATETIME WITH TIME ZONE <<INDEX>>
}

entity "seat_hold_seats" as hold_seats {
  * id : INTEGER <<PK>>
  --
  hold_id : INTEGER <<FK, INDEX>>
  seat_number : VARCHAR
  booking_id : INTEGER <<FK, NULL, UNIQUE>>
}

entity "payments" as payments {
  * id : INTEGER <<PK>>
  --
  hold_id : INTEGER <<UNIQUE, no FK>>
  user_id : INTEGER <<FK, INDEX>>
  amount : INTEGER
  currency : VARCHAR(3)
  status : VARCHAR(20)
  created_at : DATETIME WITH TIME ZONE
  paid_at : DATETIME WITH TIME ZONE <<NULL>>
}

movies ||--o{ showtimes : has
users ||--o{ bookings : owns
showtimes ||--o{ bookings : booked for
users ||--o{ seat_holds : creates
showtimes ||--o{ seat_holds : held for
seat_holds ||--|{ hold_seats : contains
bookings o|--o| hold_seats : linked booking
users ||--o{ payments : pays

note right of payments
  hold_id has a UNIQUE constraint in the model,
  but is not a foreign key to seat_holds.id.
end note

note bottom of bookings
  There is no UNIQUE constraint on
  (showtime_id, seat_number). Seat contention is
  serialized by locking the showtime row in services.
end note

note bottom of showtimes
  start_time uses PostgreSQL DATETIME without timezone.
  The application stores and returns naive UTC.
end note
@enduml
