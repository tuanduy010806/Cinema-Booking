@startuml
title Cinema Booking - Kien truc va cac thanh phan hien tai
left to right direction
skinparam backgroundColor #FAFBFD
skinparam shadowing false
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam ArrowColor #526579
skinparam packageBorderColor #8A9BAD

actor "Khach" as Guest
actor "Nguoi dung (USER)" as User
actor "Quan tri vien (ADMIN)" as Admin

rectangle "Cinema Booking API - FastAPI" as API {
  package "HTTP API /api/v1" #EAF2FB {
    component "Auth API\nregister / login / me" as AuthAPI
    component "Movies API\nlist / detail / CRUD" as MovieAPI
    component "Showtimes API\nlist / create / seats" as ShowtimeAPI
    component "Seat Holds API\ncreate / get / release" as HoldAPI
    component "Payments API\npay hold / my payments" as PaymentAPI
    component "Bookings API\nmy bookings / cancel" as BookingAPI
  }

  package "HTTP boundary" #FCE8E6 {
    component "AuthMiddleware\nvalidate JWT, reload user" as AuthMiddleware
    component "Dependencies\ncurrent identity / role checks" as Dependencies
    component "Pydantic schemas\nrequest / response" as Schemas
    component "Exception handler\ndomain errors to HTTP" as ErrorHandler
  }

  package "Business logic" #E7F3E6 {
    component "AuthService\npassword + access token" as AuthService
    component "MovieService" as MovieService
    component "ShowtimeService\nseat availability" as ShowtimeService
    component "SeatHoldService\nlock showtime, validate seats, expiry" as HoldService
    component "PaymentService\nsettle demo payment + create bookings" as PaymentService
    component "BookingService\nlist + cancel" as BookingService
  }

  package "Composition and persistence" #FFF3D6 {
    component "app/api/providers.py\nconstruct services + adapters" as Providers
    component "Repositories\nORM to domain entities" as Repositories
    component "SqlAlchemyUnitOfWork\ncommit / rollback" as UoW
    component "AsyncSession\nSQLAlchemy async engine" as Session
  }
}

database "PostgreSQL\ncinema_booking" as DB
cloud "Payment gateway\nnot integrated" as Gateway #F4F4F4

Guest --> MovieAPI : public read
Guest --> ShowtimeAPI : public read
User --> AuthAPI : register / login
User --> HoldAPI : JWT, hold / release seats
User --> PaymentAPI : JWT, pay hold
User --> BookingAPI : JWT, view / cancel own bookings
Admin --> MovieAPI : JWT, manage movies
Admin --> ShowtimeAPI : JWT, create showtimes

AuthAPI --> AuthMiddleware
MovieAPI --> AuthMiddleware
ShowtimeAPI --> AuthMiddleware
HoldAPI --> AuthMiddleware
PaymentAPI --> AuthMiddleware
BookingAPI --> AuthMiddleware
AuthMiddleware --> Dependencies
Dependencies --> Repositories : reload identity / role
API ..> Schemas : validate and serialize
API ..> ErrorHandler : map domain errors

AuthAPI --> AuthService
MovieAPI --> MovieService
ShowtimeAPI --> ShowtimeService
HoldAPI --> HoldService
PaymentAPI --> PaymentService
BookingAPI --> BookingService
Providers ..> AuthService
Providers ..> MovieService
Providers ..> ShowtimeService
Providers ..> HoldService
Providers ..> PaymentService
Providers ..> BookingService
AuthService --> Repositories
MovieService --> Repositories
ShowtimeService --> Repositories
HoldService --> Repositories
PaymentService --> Repositories
BookingService --> Repositories
Repositories --> Session
UoW --> Session
Session --> DB : SQL / asyncpg
PaymentService ..> Gateway : not connected

note bottom of API
  Hold creation and payment lock the showtime row to serialize
  conflicting operations for the same showtime.
  Payment, bookings, seat-to-booking links, and paid hold status
  are committed in one transaction. Payment is simulated.
  There is no direct booking-creation endpoint.
  No frontend, cache, or background worker is part of this application.
end note
@enduml

@startuml
title Cinema Booking - Luong giu ghe den thanh toan va tao booking
autonumber
skinparam backgroundColor #FAFBFD
skinparam shadowing false
skinparam defaultFontName Arial

actor "Nguoi dung" as User
participant "Seat Holds API" as HoldAPI
participant "SeatHoldService" as HoldService
participant "Payment API" as PaymentAPI
participant "PaymentService" as PaymentService
participant "SqlAlchemyUnitOfWork" as UoW
database "PostgreSQL" as DB

User -> HoldAPI : POST /api/v1/holds\nshowtime_id, seat_numbers
HoldAPI -> HoldService : create_hold(user, command)
HoldService -> DB : begin transaction
HoldService -> DB : lock showtime row FOR UPDATE
HoldService -> DB : read active bookings and unexpired holds
alt Showtime missing, invalid, or seat unavailable
  HoldService -> UoW : rollback
  HoldAPI --> User : HTTP error
else Seats available
  HoldService -> DB : insert seat_holds + seat_hold_seats
  HoldService -> UoW : commit
  HoldAPI --> User : 201 hold + expiry
end

User -> PaymentAPI : POST /api/v1/payments\nhold_id
PaymentAPI -> PaymentService : pay_for_hold(user, hold_id)
PaymentService -> DB : begin transaction
PaymentService -> DB : load hold; lock its showtime row
PaymentService -> DB : reload hold and validate owner/status/expiry
PaymentService -> DB : verify seats are not booked
alt Hold invalid or seat conflict
  PaymentService -> UoW : rollback
  PaymentAPI --> User : HTTP error
else Hold expired
  PaymentService -> DB : mark hold expired
  PaymentService -> UoW : commit expired status
  PaymentAPI --> User : HTTP error
else Valid active hold
  PaymentService -> DB : insert succeeded demo payment
  PaymentService -> DB : insert bookings for held seats
  PaymentService -> DB : link hold seats to bookings
  PaymentService -> DB : mark hold paid
  PaymentService -> UoW : commit all changes atomically
  PaymentAPI --> User : 201 payment + bookings
end

opt Retry payment for an already paid hold
  User -> PaymentAPI : repeat payment request
  PaymentAPI -> PaymentService : pay_for_hold(user, hold_id)
  PaymentService --> PaymentAPI : return existing payment + bookings
  PaymentAPI --> User : 200 existing result
end
@enduml
