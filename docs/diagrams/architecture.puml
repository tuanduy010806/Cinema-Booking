@startuml
title Cinema Booking - Kien truc hien tai
left to right direction
skinparam backgroundColor #FAFBFD
skinparam shadowing false
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam ArrowColor #526579
skinparam packageBorderColor #8A9BAD

actor "Khach (public reads / auth)" as Guest
actor "Nguoi dung (USER)" as User
actor "Quan tri vien (ADMIN)" as Admin

rectangle "FastAPI application" as App {
  package "Routers /api/v1" #EAF2FB {
    component "Auth API\nregister / login / me" as AuthAPI
    component "Movies API\nlist / detail / create / update / delete" as MovieAPI
    component "Showtimes API\nlist / create / seat availability" as ShowtimeAPI
    component "Seat Holds API\ncreate / get / release" as HoldAPI
    component "Payments API\npay hold / my payments" as PaymentAPI
    component "Bookings API\nmy bookings / cancel" as BookingAPI
  }

  package "Request boundary" #FCE8E6 {
    component "AuthMiddleware\nvalidate supplied JWT\nload UserEntity into request.state" as AuthMiddleware
    component "request.state.current_user\nUserEntity or None" as RequestUser
    component "Identity dependencies\nget_current_user / account" as IdentityDeps
    component "RoleChecker\ncheck ADMIN role" as RoleChecker
    component "Pydantic request / response schemas" as Schemas
    component "CinemaException handler\nmap exceptions to HTTP" as ErrorHandler
    component "app/core/exceptions.py\nCinemaException types" as DomainErrors
  }

  package "Application services" #E7F3E6 {
    component "AuthService" as AuthService
    component "MovieService" as MovieService
    component "ShowtimeService\nderive seat availability" as ShowtimeService
    component "SeatHoldService\ncreate / release hold" as HoldService
    component "PaymentService\npayment + booking transaction" as PaymentService
    component "BookingService\nlist / cancel" as BookingService
  }

  package "Domain" #EAF7F5 {
    component "Commands / Entities / Results" as DomainTypes
    component "Repository ports\napp/domain/ports.py" as RepositoryPorts
    component "UnitOfWork port\napp/domain/unit_of_work.py" as UoWPort
  }

package "Composition and infrastructure" #FFF3D6 {
    component "app/api/providers.py\nconstruct services and adapters" as Providers
    component "SQLAlchemy repositories\nmap ORM rows to entities" as Repositories
    component "SqlAlchemyUnitOfWork" as UoW
    component "AsyncSession / async engine" as Session
    component "PasswordSecurityAdapter\nJwtTokenIssuer / decode_access_token" as SecurityAdapters
  }
}

database "PostgreSQL\ncinema_booking" as DB
cloud "External payment provider\nnot integrated" as Gateway #F4F4F4

Guest --> AuthMiddleware : public reads / register / login
User --> AuthMiddleware : authenticated HTTP requests
Admin --> AuthMiddleware : authenticated HTTP requests
AuthMiddleware --> AuthAPI : call_next
AuthMiddleware --> MovieAPI : call_next
AuthMiddleware --> ShowtimeAPI : call_next
AuthMiddleware --> HoldAPI : call_next
AuthMiddleware --> PaymentAPI : call_next
AuthMiddleware --> BookingAPI : call_next
AuthMiddleware --> Repositories : valid JWT -> UserRepository.get_by_id
AuthMiddleware --> RequestUser : set loaded UserEntity
IdentityDeps --> RequestUser : read identity
RoleChecker --> RequestUser : read identity and check role
AuthAPI ..> IdentityDeps : GET /me only
MovieAPI ..> RoleChecker : POST / PUT / DELETE
ShowtimeAPI ..> RoleChecker : POST only
HoldAPI ..> IdentityDeps
PaymentAPI ..> IdentityDeps
BookingAPI ..> IdentityDeps
App ..> Schemas : validate / serialize
App ..> ErrorHandler : handle domain exceptions
ErrorHandler ..> DomainErrors

AuthAPI --> AuthService
MovieAPI --> MovieService
ShowtimeAPI --> ShowtimeService
HoldAPI --> HoldService
PaymentAPI --> PaymentService
BookingAPI --> BookingService

Providers ..> AuthService
Providers ..> MovieService
Providers ..> ShowtimeService
Providers ..> HoldService
Providers ..> PaymentService
Providers ..> BookingService
AuthAPI ..> Providers : Depends(get_auth_service)
MovieAPI ..> Providers : Depends(get_movie_service)
ShowtimeAPI ..> Providers : Depends(get_showtime_service)
HoldAPI ..> Providers : Depends(get_seat_hold_service)
PaymentAPI ..> Providers : Depends(get_payment_service)
BookingAPI ..> Providers : Depends(get_booking_service)
Providers ..> Repositories : build adapters
Providers ..> UoW : build transaction boundary
Providers ..> SecurityAdapters : inject auth adapters

AuthService ..> DomainTypes
MovieService ..> DomainTypes
ShowtimeService ..> DomainTypes
HoldService ..> DomainTypes
PaymentService ..> DomainTypes
BookingService ..> DomainTypes
AuthService ..> RepositoryPorts
MovieService ..> RepositoryPorts
ShowtimeService ..> RepositoryPorts
HoldService ..> RepositoryPorts
PaymentService ..> RepositoryPorts
BookingService ..> RepositoryPorts
AuthService ..> DomainErrors
MovieService ..> DomainErrors
ShowtimeService ..> DomainErrors
HoldService ..> DomainErrors
PaymentService ..> DomainErrors
BookingService ..> DomainErrors
AuthService --> SecurityAdapters
AuthMiddleware --> SecurityAdapters : decode_access_token

AuthService --> UoW
MovieService --> UoW
ShowtimeService --> UoW
HoldService --> UoW
PaymentService --> UoW
BookingService --> UoW

Repositories ..|> RepositoryPorts
UoW ..|> UoWPort
Repositories --> Session
UoW --> Session
AuthMiddleware --> Session : separate AsyncSessionLocal lookup
Session --> DB : SQL / asyncpg
PaymentService ..> Gateway : no integration

note bottom of App
  create_hold, pay_for_hold and release_hold lock the showtime row.
  This serializes those operations for the same showtime until commit/rollback.
  Payment, bookings, seat-to-booking links and paid hold status commit atomically.
  Bookings are created by PaymentService; there is no booking-create endpoint.
  No frontend, cache or background worker is included.
end note
@enduml

@startuml
title Cinema Booking - Luong giu ghe, thanh toan va booking
autonumber
skinparam backgroundColor #FAFBFD
skinparam shadowing false
skinparam defaultFontName Arial

actor "Nguoi dung" as User
participant "AuthMiddleware" as Auth
participant "JWT decoder" as JWT
participant "UserRepository" as UserRepo
participant "Seat Holds API" as HoldAPI
participant "Identity dependency" as Identity
participant "SeatHoldService" as HoldService
participant "Payments API" as PaymentAPI
participant "PaymentService" as PaymentService
participant "SqlAlchemyUnitOfWork" as UoW
database "PostgreSQL" as DB

note over Auth,Identity
  Each request with a supplied bearer token is validated by middleware.
  Middleware loads UserEntity and sets request.state.current_user;
  the route dependency reads that identity before calling the service.
end note

User -> Auth : POST /api/v1/holds\nAuthorization: Bearer
Auth -> JWT : decode_access_token(token)
JWT --> Auth : user_id
Auth -> UserRepo : get_by_id(user_id)
UserRepo -> DB : SELECT user
DB --> UserRepo : user row
UserRepo --> Auth : UserEntity
Auth -> HoldAPI : call_next with request.state.current_user
HoldAPI -> Identity : get_current_user
Identity --> HoldAPI : user identity
HoldAPI -> HoldService : create_hold(user_id, command)
HoldService -> DB : lock showtime row FOR UPDATE
HoldService -> DB : read active bookings and unexpired holds
alt Showtime missing, invalid seat, or seat unavailable
  HoldService -> UoW : rollback
  HoldAPI --> User : 4xx domain error
else Seats available
  HoldService -> DB : insert seat_holds and seat_hold_seats
  HoldService -> UoW : commit
  HoldAPI --> User : 201 hold + expiry
  alt User releases the hold
    User -> Auth : DELETE /api/v1/holds/{hold_id}
    Auth -> JWT : decode_access_token(token)
    JWT --> Auth : user_id
    Auth -> UserRepo : get_by_id(user_id)
    UserRepo -> DB : SELECT user
    DB --> UserRepo : user row
    UserRepo --> Auth : UserEntity
    Auth -> HoldAPI : call_next with current user
    HoldAPI -> Identity : get_current_user
    Identity --> HoldAPI : user identity
    HoldAPI -> HoldService : release_hold(user_id, hold_id)
    HoldService -> DB : lock showtime; reload and validate hold
    HoldService -> DB : set released or expired status
    HoldService -> UoW : commit
    HoldAPI --> User : 200 hold state
  else User pays for the hold
    User -> Auth : POST /api/v1/payments\nhold_id
    Auth -> JWT : decode_access_token(token)
    JWT --> Auth : user_id
    Auth -> UserRepo : get_by_id(user_id)
    UserRepo -> DB : SELECT user
    DB --> UserRepo : user row
    UserRepo --> Auth : UserEntity
    Auth -> PaymentAPI : call_next with current user
    PaymentAPI -> Identity : get_current_user
    Identity --> PaymentAPI : user identity
    PaymentAPI -> PaymentService : pay_for_hold(user_id, hold_id)
    PaymentService -> DB : load hold and verify ownership
    PaymentService -> DB : lock showtime; reload hold
    alt Hold was already paid (retry)
      PaymentService -> DB : load original payment and linked bookings
      PaymentService -> UoW : commit read transaction
      PaymentAPI --> User : 200 original payment + bookings
    else Hold is invalid or a seat conflicts
      PaymentService -> UoW : rollback
      PaymentAPI --> User : 4xx domain error
    else Hold has expired
      PaymentService -> DB : mark hold expired
      PaymentService -> UoW : commit expired state
      PaymentAPI --> User : 409 hold expired
    else Active hold is valid
      PaymentService -> DB : insert succeeded demo payment
      PaymentService -> DB : insert bookings for held seats
      PaymentService -> DB : link seats to bookings; mark hold paid
      PaymentService -> UoW : commit all changes atomically
      PaymentAPI --> User : 201 payment + bookings
    end
  end
end
@enduml
