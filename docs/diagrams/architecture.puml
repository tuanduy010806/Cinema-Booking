@startuml
title Cinema Booking - Kien truc he thong hien tai

left to right direction
skinparam backgroundColor #FAFBFD
skinparam shadowing false
skinparam roundcorner 12
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam ArrowColor #526579
skinparam packageBorderColor #8A9BAD

actor "Khach" as Guest
actor "Nguoi dung (USER)" as User
actor "Quan tri vien (ADMIN)" as Admin

rectangle "Cinema Booking API\nPython 3.12 - FastAPI" as API {
  package "HTTP API /api/v1" #EAF2FB {
    component "Auth API\nregister / login / me" as AuthAPI
    component "Movies API\nlist / detail / CRUD" as MovieAPI
    component "Showtimes API\nlist / create / seats" as ShowtimeAPI
    component "Seat Holds API\ncreate / get / release" as HoldAPI
    component "Payments API\npay hold / my payments" as PaymentAPI
    component "Bookings API\nmy bookings / cancel" as BookingAPI
  }

  package "Middleware, dependencies va validation" #FCE8E6 {
    component "AuthMiddleware\nJWT Bearer validation\nreload user + role from DB" as AuthMiddleware
    component "Current user dependencies" as CurrentUser
    component "RoleChecker\nADMIN endpoints" as RoleChecker
    component "Pydantic request / response schemas" as Schemas
    component "CinemaException handler\nHTTP error responses" as ErrorHandler
  }

  package "Business logic - Services" #E7F3E6 {
    component "AuthService\npassword + access token" as AuthService
    component "MovieService" as MovieService
    component "ShowtimeService\nseat availability" as ShowtimeService
    component "SeatHoldService\nseat hold + expiry" as HoldService
    component "PaymentService\ndemo payment + booking creation" as PaymentService
    component "BookingService\nlist + cancel" as BookingService
  }

  package "Data access" #FFF3D6 {
    component "Repositories\nusers, movies, showtimes,\nholds, payments, bookings" as Repositories
    component "SqlAlchemyUnitOfWork\ncommit / rollback" as UoW
    component "SQLAlchemy AsyncSession\nasync engine + pool" as Session
  }
}

database "PostgreSQL 16\ncinema_booking" as DB
cloud "External payment gateway\nnot integrated" as Gateway #F4F4F4

Guest --> MovieAPI : HTTP / JSON\npublic read
Guest --> ShowtimeAPI : HTTP / JSON\npublic read
User --> AuthAPI : register / login
User --> HoldAPI : JWT\nhold or release seats
User --> PaymentAPI : JWT\npay a hold
User --> BookingAPI : JWT\nview or cancel own bookings
Admin --> MovieAPI : JWT\nmanage movies
Admin --> ShowtimeAPI : JWT\ncreate showtimes

AuthAPI --> AuthMiddleware
MovieAPI --> AuthMiddleware
ShowtimeAPI --> AuthMiddleware
HoldAPI --> AuthMiddleware
PaymentAPI --> AuthMiddleware
BookingAPI --> AuthMiddleware
AuthMiddleware --> CurrentUser
AuthMiddleware --> Repositories : look up current user
CurrentUser --> RoleChecker : identity / authorization
AuthAPI ..> Schemas
MovieAPI ..> Schemas
ShowtimeAPI ..> Schemas
HoldAPI ..> Schemas
PaymentAPI ..> Schemas
BookingAPI ..> Schemas
API ..> ErrorHandler : domain errors

AuthAPI --> AuthService
MovieAPI --> MovieService
ShowtimeAPI --> ShowtimeService
HoldAPI --> HoldService
PaymentAPI --> PaymentService
BookingAPI --> BookingService

AuthService --> Repositories
MovieService --> Repositories
ShowtimeService --> Repositories
HoldService --> Repositories
PaymentService --> Repositories
BookingService --> Repositories
Repositories --> Session
UoW --> Session
Session --> DB : SQL / asyncpg
PaymentService ..> Gateway : no integration

note bottom of API
  Docker Compose runs two services: the FastAPI API and PostgreSQL.
  Seat hold TTL is configurable (default 300 seconds).
  Payment is simulated locally. A successful payment creates bookings
  and marks the hold paid in one database transaction.
  There is no direct booking-creation endpoint; the booking API lists
  and cancels the authenticated user's bookings.
  No frontend, background worker, cache, or external payment service
  is currently part of the deployed application.
end note

@enduml
