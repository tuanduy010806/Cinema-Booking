# =============================================================================
# TEST ENVIRONMENT — example configuration
# =============================================================================
# Copy this file to .env.test and fill in your real credentials.
# .env.test is listed in .gitignore and must NEVER be committed.
#
# Driver note:
#   Use the psycopg3 driver (psycopg):  postgresql+psycopg://...
#   Use the psycopg2 driver:            postgresql+psycopg2://...
#
# The test database must be separate from the production database.
# create_test_db.py will refuse to run if TEST_DATABASE_URL is missing.
# =============================================================================

TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/cinema_booking_test
