# Application settings read by app.core.config.Settings.
DATABASE_URL=postgresql+asyncpg://cinema:123456@localhost:5432/cinema_booking
SECRET_KEY=replace-this-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set true to log SQL statements during local debugging.
SQL_ECHO=false
# Demo price per seat; clients cannot choose or submit the amount.
DEMO_PAYMENT_AMOUNT_VND=100000
# Five minutes; hold duration is enforced by the backend.
SEAT_HOLD_TTL_SECONDS=300
# Used by Docker Compose for the local PostgreSQL service and API connection.
POSTGRES_PASSWORD=123456
