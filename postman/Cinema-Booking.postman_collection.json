{
  "info": {
    "name": "Cinema Booking API - Automated Tests",
    "description": "Postman Runner collection for the FastAPI project. Import the collection, start the API, seed data, then run the collection. The admin create-showtime request leaves a sample showtime in the database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set(\"runId\", Date.now().toString());",
          "pm.collectionVariables.set(\"futureStart\", new Date(Date.now() + 86400000).toISOString().slice(0, 19));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "aliceEmail",
      "value": "alice@example.com"
    },
    {
      "key": "alicePassword",
      "value": "Alice123!"
    },
    {
      "key": "bobEmail",
      "value": "bob@example.com"
    },
    {
      "key": "bobPassword",
      "value": "Bob123456!"
    },
    {
      "key": "adminEmail",
      "value": "admin@cinema.local"
    },
    {
      "key": "adminPassword",
      "value": "Admin123!"
    },
    {
      "key": "aliceToken",
      "value": ""
    },
    {
      "key": "bobToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "sampleMovieId",
      "value": ""
    },
    {
      "key": "showtimeId",
      "value": ""
    },
    {
      "key": "bookingSeat",
      "value": ""
    },
    {
      "key": "holdSeats",
      "value": "[]"
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "createdHoldId",
      "value": ""
    },
    {
      "key": "paymentId",
      "value": ""
    },
    {
      "key": "createdMovieId",
      "value": ""
    },
    {
      "key": "createdMovieTitle",
      "value": ""
    },
    {
      "key": "updatedMovieTitle",
      "value": ""
    },
    {
      "key": "createdShowtimeId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "futureStart",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - User booking and seat-hold flow",
      "item": [
        {
          "name": "Login as Alice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{aliceEmail}}\",\"password\":\"{{alicePassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Access token is returned\", function () {",
                  "    pm.expect(data.access_token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"aliceToken\", data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Identity matches Alice\", function () {",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.email).to.eql(pm.collectionVariables.get(\"aliceEmail\"));",
                  "    pm.expect(data.role).to.eql(\"USER\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/movies",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const movies = pm.response.json();",
                  "pm.test(\"Movies are returned\", function () { pm.expect(movies).to.be.an(\"array\").that.is.not.empty; });",
                  "if (movies.length) pm.collectionVariables.set(\"sampleMovieId\", movies[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List showtimes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/showtimes",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const showtimes = pm.response.json();",
                  "pm.test(\"Sample showtimes are returned\", function () { pm.expect(showtimes).to.be.an(\"array\").that.is.not.empty; });",
                  "if (showtimes.length) pm.collectionVariables.set(\"showtimeId\", showtimes[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get available seats",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/showtimes/{{showtimeId}}/seats",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const seats = pm.response.json();",
                  "const available = seats.filter(seat => seat.is_available);",
                  "pm.test(\"At least three seats are available\", function () { pm.expect(available.length).to.be.at.least(3); });",
                  "if (available.length >= 3) {",
                  "    pm.collectionVariables.set(\"bookingSeat\", available[0].seat_number);",
                  "    pm.collectionVariables.set(\"holdSeats\", JSON.stringify([available[1].seat_number, available[2].seat_number]));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create direct booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"showtime_id\":{{showtimeId}},\"seat_number\":\"{{bookingSeat}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const booking = pm.response.json();",
                  "pm.test(\"Booking is created as active\", function () {",
                  "    pm.expect(booking.id).to.be.a(\"number\");",
                  "    pm.expect(booking.status).to.eql(\"active\");",
                  "    pm.expect(booking.seat_number).to.eql(pm.collectionVariables.get(\"bookingSeat\"));",
                  "});",
                  "pm.collectionVariables.set(\"bookingId\", booking.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject duplicate booking",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/bookings/",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"showtime_id\":{{showtimeId}},\"seat_number\":\"{{bookingSeat}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List my bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const bookings = pm.response.json();",
                  "pm.test(\"New booking appears in my list\", function () {",
                  "    pm.expect(bookings.some(item => item.id === Number(pm.collectionVariables.get(\"bookingId\")))).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Cancel booking",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings/{{bookingId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Booking status changes to cancelled\", function () { pm.expect(pm.response.json().status).to.eql(\"cancelled\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Create two-seat hold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/holds",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"showtime_id\":{{showtimeId}},\"seat_numbers\":{{holdSeats}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const hold = pm.response.json();",
                  "pm.test(\"Hold is active and contains two seats\", function () {",
                  "    pm.expect(hold.id).to.be.a(\"number\");",
                  "    pm.expect(hold.status).to.eql(\"active\");",
                  "    pm.expect(hold.seat_numbers).to.have.length(2);",
                  "});",
                  "pm.collectionVariables.set(\"createdHoldId\", hold.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get hold",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/holds/{{createdHoldId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Hold belongs to Alice\", function () {",
                  "    const hold = pm.response.json();",
                  "    pm.expect(hold.id).to.eql(Number(pm.collectionVariables.get(\"createdHoldId\")));",
                  "    pm.expect(hold.user_id).to.eql(2);",
                  "    pm.expect(hold.status).to.eql(\"active\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject duplicate hold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/holds",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"showtime_id\":{{showtimeId}},\"seat_numbers\":{{holdSeats}}}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Held seats are unavailable",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/showtimes/{{showtimeId}}/seats",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const unavailable = new Set(pm.collectionVariables.get(\"holdSeats\") ? JSON.parse(pm.collectionVariables.get(\"holdSeats\")) : []);",
                  "const seats = pm.response.json();",
                  "pm.test(\"Held seats are marked unavailable\", function () {",
                  "    unavailable.forEach(number => pm.expect(seats.find(seat => seat.seat_number === number).is_available).to.eql(false));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Release hold",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/holds/{{createdHoldId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Hold status changes to released\", function () { pm.expect(pm.response.json().status).to.eql(\"released\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get released hold",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/holds/{{createdHoldId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{aliceToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Released status is returned\", function () { pm.expect(pm.response.json().status).to.eql(\"released\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Payment flow",
      "item": [
        {
          "name": "Login as Bob",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{bobEmail}}\",\"password\":\"{{bobPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json();",
                  "pm.test(\"Access token is returned\", function () {",
                  "    pm.expect(data.access_token).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.collectionVariables.set(\"bobToken\", data.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Pay sample hold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/payments",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hold_id\":920005}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Payment request succeeds or returns an idempotent result\", function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const result = pm.response.json();",
                  "pm.test(\"Payment succeeded and two bookings are returned\", function () {",
                  "    pm.expect(result.payment.status).to.eql(\"succeeded\");",
                  "    pm.expect(result.payment.hold_id).to.eql(920005);",
                  "    pm.expect(result.bookings).to.have.length(2);",
                  "});",
                  "pm.collectionVariables.set(\"paymentId\", result.payment.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Retry payment returns original result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/payments",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"hold_id\":920005}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const result = pm.response.json();",
                  "pm.test(\"Retry returns the original payment and bookings\", function () {",
                  "    pm.expect(result.payment.id).to.eql(Number(pm.collectionVariables.get(\"paymentId\")));",
                  "    pm.expect(result.bookings).to.have.length(2);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Bob's payments",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/payments/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const payments = pm.response.json();",
                  "pm.test(\"Payment for hold 920005 is listed\", function () {",
                  "    pm.expect(payments.some(item => item.hold_id === 920005)).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List Bob's bookings",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/bookings/me",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bobToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Bookings created by payment are listed\", function () {",
                  "    pm.expect(pm.response.json().some(item => item.showtime_id === 1 && [\"10\", \"11\"].includes(item.seat_number))).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 - Admin management flow",
      "item": [
        {
          "name": "Login as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "auth": {
              "type": "noauth"
            },
